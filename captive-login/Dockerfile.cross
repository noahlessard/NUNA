FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Restrict default sources to amd64, then add ports.ubuntu.com for armhf
# (archive.ubuntu.com does not host armhf — that lives on ports.ubuntu.com)
RUN sed -i 's/^deb /deb [arch=amd64] /' /etc/apt/sources.list && \
    dpkg --add-architecture armhf && \
    echo "deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports focal main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports focal-updates main restricted universe multiverse" >> /etc/apt/sources.list && \
    echo "deb [arch=armhf] http://ports.ubuntu.com/ubuntu-ports focal-security main restricted universe multiverse" >> /etc/apt/sources.list

# Install cross-compiler and static OpenSSL/zlib/c-ares for armhf.
# c-ares is required so curl can resolve hostnames without going through
# glibc's NSS (which dlopen's nss_dns.so at runtime and breaks fully-static
# binaries — see --enable-ares in the curl configure step below).
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake make wget ca-certificates \
    gcc-arm-linux-gnueabihf \
    g++-arm-linux-gnueabihf \
    libssl-dev:armhf \
    zlib1g-dev:armhf \
    libc-ares-dev:armhf \
    && rm -rf /var/lib/apt/lists/*

# Build a minimal static libcurl from source (no GSSAPI, no PSL, no IDN,
# HTTPS only) to avoid the transitive Kerberos/libidn2 dependency chain
# that Ubuntu's pre-built libcurl.a carries.
ARG CURL_VERSION=7.88.1
RUN wget -q https://curl.se/download/curl-${CURL_VERSION}.tar.gz && \
    tar xf curl-${CURL_VERSION}.tar.gz && \
    cd curl-${CURL_VERSION} && \
    ./configure \
        --host=arm-linux-gnueabihf \
        --prefix=/opt/curl-arm \
        --disable-shared --enable-static \
        --without-gssapi \
        --without-gnutls \
        --with-openssl \
        --disable-ldap --disable-ldaps \
        --disable-rtsp --disable-ftp \
        --disable-dict --disable-telnet \
        --disable-tftp --disable-pop3 \
        --disable-imap --disable-smtp \
        --disable-gopher \
        --enable-ares \
        --without-brotli \
        --without-nghttp2 \
        --without-libssh2 \
        --without-librtmp \
        --without-libidn2 \
        --without-libpsl \
        CC=arm-linux-gnueabihf-gcc \
        CPPFLAGS="-I/usr/include -I/usr/include/arm-linux-gnueabihf" \
        LDFLAGS="-L/usr/lib/arm-linux-gnueabihf" \
        PKG_CONFIG_PATH="/usr/lib/arm-linux-gnueabihf/pkgconfig" \
        PKG_CONFIG_LIBDIR="/usr/lib/arm-linux-gnueabihf/pkgconfig" && \
    make -j$(nproc) && make install && \
    cd / && rm -rf curl-${CURL_VERSION} curl-${CURL_VERSION}.tar.gz

WORKDIR /work
